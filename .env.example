# Copy to .env and fill with your Supabase project's values (Settings → API).
# These are all public/client-safe values.
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Sentry — optional. Get your DSN from sentry.io > Project > Settings > Client Keys.
# Leave blank to disable error tracking.
VITE_SENTRY_DSN=""
